# Copy to .env and replace every placeholder. Never commit .env.

# PostgreSQL
POSTGRES_USER=shortly_app
POSTGRES_PASSWORD=replace-with-a-strong-local-database-password
POSTGRES_DB=shortly
DB_TIMEZONE=Asia/Jakarta

# Base URL used to build short links (the web container's port)
PUBLIC_BASE_URL=http://localhost:8090
WEB_PORT=8090
API_PORT=3000

# Abuse protection: max create requests per IP per minute
CREATE_RATE_LIMIT=30

# Adminer (profile "tools")
ADMINER_PORT=8091
